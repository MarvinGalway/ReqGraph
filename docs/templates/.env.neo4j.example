# Copy to .env.neo4j (next to docker-compose.neo4j.yml, in the target
# project's own repo root) and adjust only if these defaults collide with
# something else already running — e.g. ReqGraph's own instance uses
# 7474/7687/5005, so this template defaults one port higher on each to run
# alongside it without a clash. If you have several projects' instances up
# at once, give each its own set of ports.

NEO4J_PASSWORD=reqgraph-dev
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688
NEODASH_PORT=5006
