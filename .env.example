# Neo4j (see docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=reqgraph-dev
NEO4J_DATABASE=neo4j

# Anthropic API — required for LLM-backed commands (run-critic, formalize,
# derive-tasks, bootstrap-infer, impact, triage-issue) on any role still on
# the default "anthropic" provider (see REQGRAPH_PROVIDER* below).
ANTHROPIC_API_KEY=

# OpenAI API — only required for roles switched to the "openai" provider.
# Also requires: pip install -e ".[llm-openai]"
OPENAI_API_KEY=

# Provider selection. Default is "anthropic" for every role. Set the global
# switch to move every role to OpenAI at once, or override a single role.
# Precedence: REQGRAPH_PROVIDER_<ROLE> > REQGRAPH_PROVIDER > per-role default.
# REQGRAPH_PROVIDER=openai
# REQGRAPH_PROVIDER_CRITIC=openai
# REQGRAPH_PROVIDER_FORMALIZER=openai
# REQGRAPH_PROVIDER_PLANNER=openai
# REQGRAPH_PROVIDER_REVERSE_ANALYST=openai
# REQGRAPH_PROVIDER_IMPACT_ANALYST=openai
# REQGRAPH_PROVIDER_ISSUE_TRIAGE=openai
# REQGRAPH_PROVIDER_LIBRARIAN=openai
# REQGRAPH_PROVIDER_REVIEWER=openai

# Optional per-role model overrides (defaults are set in reqgraph/llm/roles.py;
# this always wins regardless of which provider the role resolved to)
# REQGRAPH_MODEL_CRITIC=claude-opus-5           # or e.g. gpt-5.1 on openai
# REQGRAPH_MODEL_FORMALIZER=claude-opus-5
# REQGRAPH_MODEL_PLANNER=claude-sonnet-5
# REQGRAPH_MODEL_REVERSE_ANALYST=claude-opus-5
# REQGRAPH_MODEL_IMPACT_ANALYST=claude-opus-5
# REQGRAPH_MODEL_ISSUE_TRIAGE=claude-sonnet-5
# REQGRAPH_MODEL_LIBRARIAN=claude-haiku-4-5-20251001

# Where /.project-state/ lives for the current project (defaults to CWD)
# REQGRAPH_PROJECT_ROOT=.
