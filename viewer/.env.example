# Copy to .env.local (gitignored by Vite convention) and adjust if your
# docker-compose overrides differ from the defaults in ../docker-compose.yml.
VITE_NEO4J_URI=bolt://localhost:7687
VITE_NEO4J_USER=neo4j
VITE_NEO4J_PASSWORD=reqgraph-dev
VITE_NEO4J_DATABASE=neo4j

# Local API used only by the Bootstrap tab (runs bootstrap-scan/observe/infer
# against the project's real filesystem — see reqgraph/api/server.py).
# Start it with `graph-cli serve` from the project's own directory.
VITE_API_URL=http://localhost:8321
